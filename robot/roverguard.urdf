<?xml version="1.0"?>

<robot name="roverguard">

    <!-- Jsm l2asasi -->
    <link name="base_link">
        <inertial>
            <origin xyz="0 0 0"/>
            <mass value="1.0"/>
            <inertia
                ixx="0.00387" ixy="0" ixz="0"
                iyy="0.00803" iyz="0"
                izz="0.01083"/>
        </inertial>

        <visual>
            <geometry>
                <box size="0.30 0.20 0.08"/>
            </geometry>
            <material name="blue">
                <color rgba="0.1 0.3 0.8 1"/>
            </material>
        </visual>

        <collision>
            <geometry>
                <box size="0.30 0.20 0.08"/>
            </geometry>
        </collision>
    </link>


    <!-- Roue lisra -->
    <link name="left_wheel">
        <inertial>
            <mass value="0.1"/>
            <inertia
                ixx="0.00007" ixy="0" ixz="0"
                iyy="0.000125" iyz="0"
                izz="0.00007"/>
        </inertial>

        <visual>
            <origin rpy="1.5708 0 0"/>
            <geometry>
                <cylinder radius="0.05" length="0.03"/>
            </geometry>
            <material name="left_wheel_color">
                <color rgba="0.05 0.05 0.05 1"/>
            </material>
        </visual>

        <collision>
            <origin rpy="1.5708 0 0"/>
            <geometry>
                <cylinder radius="0.05" length="0.03"/>
            </geometry>
        </collision>
    </link>

    <joint name="left_wheel_joint" type="continuous">
        <parent link="base_link"/>
        <child link="left_wheel"/>
        <origin xyz="0 0.115 -0.01"/>
        <axis xyz="0 1 0"/>
        <dynamics damping="0.05" friction="0"/>
    </joint>


    <!-- Roue limna -->
    <link name="right_wheel">
        <inertial>
            <mass value="0.1"/>
            <inertia
                ixx="0.00007" ixy="0" ixz="0"
                iyy="0.000125" iyz="0"
                izz="0.00007"/>
        </inertial>

        <visual>
            <origin rpy="1.5708 0 0"/>
            <geometry>
                <cylinder radius="0.05" length="0.03"/>
            </geometry>
            <material name="right_wheel_color">
                <color rgba="0.05 0.05 0.05 1"/>
            </material>
        </visual>

        <collision>
            <origin rpy="1.5708 0 0"/>
            <geometry>
                <cylinder radius="0.05" length="0.03"/>
            </geometry>
        </collision>
    </link>

    <joint name="right_wheel_joint" type="continuous">
        <parent link="base_link"/>
        <child link="right_wheel"/>
        <origin xyz="0 -0.115 -0.01"/>
        <axis xyz="0 1 0"/>
        <dynamics damping="0.05" friction="0"/>
    </joint>


    <!-- Da3ama sghira ta7t lwer -->
    <link name="rear_caster">
        <inertial>
            <mass value="0.03"/>
            <inertia
                ixx="0.0000048" ixy="0" ixz="0"
                iyy="0.0000048" iyz="0"
                izz="0.0000048"/>
        </inertial>

        <visual>
            <geometry>
                <sphere radius="0.02"/>
            </geometry>
            <material name="caster_color">
                <color rgba="0.7 0.7 0.7 1"/>
            </material>
        </visual>

        <collision>
            <geometry>
                <sphere radius="0.02"/>
            </geometry>
        </collision>
    </link>

    <joint name="rear_caster_joint" type="fixed">
        <parent link="base_link"/>
        <child link="rear_caster"/>
        <origin xyz="-0.11 0 -0.04"/>
    </joint>


    <!-- Sensor dyal lmasafa f 9dam robot -->
    <link name="front_sensor">
        <inertial>
            <mass value="0.01"/>
            <inertia
                ixx="0.0000017" ixy="0" ixz="0"
                iyy="0.0000007" iyz="0"
                izz="0.0000017"/>
        </inertial>

        <visual>
            <geometry>
                <box size="0.02 0.04 0.02"/>
            </geometry>
            <material name="sensor_red">
                <color rgba="1 0.1 0.1 1"/>
            </material>
        </visual>
    </link>

    <joint name="front_sensor_joint" type="fixed">
        <parent link="base_link"/>
        <child link="front_sensor"/>
        <origin xyz="0.16 0 0.02"/>
    </joint>
</robot>